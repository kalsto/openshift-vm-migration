{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Monitoring Query Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/appliance/monitoring/query": {
      "get": {
        "operationId": "Appliance.Monitoring.Query_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": [
                  {
                    "name": "cpu.util",
                    "interval": "MINUTES5",
                    "function": "AVG",
                    "start_time": "2026-01-01T00:00:00.000Z",
                    "end_time": "2026-01-02T00:00:00.000Z",
                    "data": [
                      "3.5",
                      "4.1",
                      "2.9"
                    ]
                  }
                ]
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
